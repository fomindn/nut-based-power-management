# ------------------------------------------------------------
# powerctl env
# Centralized configuration for NUT + Supervisor
# ------------------------------------------------------------

# --- Global Paths -------------------------------------------
POWERCTL_ROOT="/usr/local/powerctl"       # Root install directory
POWERCTL_RUN_DIR="/run/powerctl"          # Runtime directory (tmpfs)
STATE_DIR="/run/powerctl/state"           # Supervisor state directory
NUT_CONF_DIR="/etc/nut"                   # NUT config directory

# --- Binaries / Commands ------------------------------------
UPSMON_BIN="/usr/sbin/upsmon"
UPSC_BIN="/usr/bin/upsc"
UPSSCHED_BIN="/usr/sbin/upssched"
SHUTDOWN_CMD="/sbin/shutdown -h now"
WALL_CMD="/usr/bin/wall"
LOGGER_BIN="/usr/bin/logger"
LOG_FORMAT="kv"                 # kv or plain (structured key=value messages)
WAKEONLAN_BIN="/usr/bin/wakeonlan"
SSH_BIN="/usr/bin/ssh"
TIMEOUT_BIN="/usr/bin/timeout"
PING_BIN="/bin/ping"
NC_BIN="/bin/nc"

# --- UPS Identification -------------------------------------
UPS_NAME="ups"
UPS_HOST="127.0.0.1"

# --- Battery Thresholds -------------------------------------
MIN_START_BATTERY=30        # Auto-wake requires >= this value (%)
CRITICAL_BATTERY=20         # Low battery emergency threshold (%)

# --- Schedule / Day-Night -----------------------------------
DAY_START="09:00"
DAY_END="23:59"
SCHEDULED_SHUTDOWN_TIME="23:59"
ENABLE_SCHEDULED_SHUTDOWN="yes"

# --- Supervisor Timing --------------------------------------
CHECK_INTERVAL=10               # Main loop interval (seconds)
BATTERY_GRACE_PERIOD=180        # Wait before shutdown on power loss
FORCE_SHUTDOWN_TIMEOUT=180      # Max wait for graceful shutdown

# Power stability before auto-wake (seconds)
POWER_STABLE_TIME_LOW=120
POWER_STABLE_TIME_HIGH=60

# Debounce / flapping protection
ONLINE_STABLE_MIN=30
ONBATT_STABLE_MIN=10

# Auto-wake limits
AUTO_WAKE_MAX_ATTEMPTS=3
AUTO_WAKE_COOLDOWN=30

# Shutdown request cooldown
SHUTDOWN_COOLDOWN=30

# Stale ONLINE marker TTL (0 disables)
POWER_RESTORED_TTL=0

# Periodic status log (0 disables)
STATUS_LOG_INTERVAL=0

# --- Communication Alerts -----------------------------------
COMM_LOG_INTERVAL=60       # Throttle comm loss logs (seconds)
COMM_WALL_INTERVAL=30      # Throttle wall alerts (seconds)

# --- WOL Settings -------------------------------------------
WOL_RETRIES=3
WOL_INTERVAL=15

# --- SSH Settings -------------------------------------------
SSH_TIMEOUT=5

# --- Client Fallback Timers ---------------------------------
NUT_CLIENT_ONBATT_GRACE=300        # Local shutdown after ONBATT (sec)
NUT_CLIENT_COMMFAULT_GRACE=1800    # Local shutdown after COMMFAULT (sec)

# --- NUT Configuration Notes --------------------------------
# NUT server/client configs are authoritative and live in /etc/nut.
# This env file is used by supervisor and helper scripts only.
